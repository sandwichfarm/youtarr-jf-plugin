<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!--
      The plugin project sets <ExcludeAssets>runtime</ExcludeAssets> on the Jellyfin packages
      so the server's own DLLs are NOT bundled in the plugin (Pitfall 1 / T-01-01). That exclusion
      means the Jellyfin runtime assemblies are absent from the test output too, which breaks
      tests that touch MediaBrowser types (FileSystemMetadata, IResolverIgnoreRule, Series).
      The test project is never deployed as a plugin, so it references the Jellyfin packages
      directly (WITHOUT ExcludeAssets) to load those assemblies at test runtime.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.Youtarr\Jellyfin.Plugin.Youtarr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
